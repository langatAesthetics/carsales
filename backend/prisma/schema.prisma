generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars      Car[]
}

model Car {
  id            String   @id @default(cuid())

  title         String
  brand         String
  model         String?
  year          Int?

  price         Float

  mileage       Int?
  fuelType      FuelType?
  transmission  Transmission?
  engineSize    Int?
  driveType     DriveType?

  condition     Condition?
  status        Status      @default(AVAILABLE)

  description   String?
  imageUrl      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum DriveType {
  AWD
  FWD
  RWD
}

enum Condition {
  NEW
  USED
}

enum Status {
  AVAILABLE
  SOLD
}